{
  "update_url": "https://clients2.google.com/service/update2/crx",
  "manifest_version": 2,
  "name": "ChatGPT",
  "description": "Control your browser with ChatGPT.",
  "version": "1.26.1005.11759",
  "icons": {
    "16": "images/icon16.png",
    "32": "images/icon32.png",
    "128": "images/icon128.png"
  },
  "content_security_policy": "script-src 'self'; object-src 'none'; connect-src 'self' http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:* https://ab.chatgpt.com https://chatgpt.com https://api.openai.com https://api.openai.org https://*.blob.core.windows.net https://*.oaiusercontent.com https://*.s3.ap-northeast-1.amazonaws.com https://*.s3.ap-northeast-2.amazonaws.com https://*.s3.ap-south-1.amazonaws.com https://*.s3.ap-southeast-1.amazonaws.com https://*.s3.ap-southeast-2.amazonaws.com https://*.s3.ca-central-1.amazonaws.com https://*.s3.eu-central-1.amazonaws.com https://*.s3.eu-south-2.amazonaws.com https://*.s3.eu-west-1.amazonaws.com https://*.s3.eu-west-2.amazonaws.com https://*.s3.us-east-1.amazonaws.com https://*.s3.us-east-2.amazonaws.com https://*.s3.us-west-1.amazonaws.com; font-src 'self' https://cdn.openai.com; frame-src 'self' https://chatgpt.com http://*.localhost:*;",
  "minimum_chrome_version": "116",
  "permissions": [
    "alarms",
    "bookmarks",
    "debugger",
    "declarativeNetRequestWithHostAccess",
    "downloads",
    "favicon",
    "history",
    "nativeMessaging",
    "notifications",
    "offscreen",
    "scripting",
    "sessions",
    "storage",
    "tabGroups",
    "tabs",
    "topSites",
    "webNavigation",
    "contextMenus",
    "sidePanel",
    "<all_urls>",
    "webRequest"
  ],
  "commands": {
    "open-codex-side-panel": {
      "description": "Open ChatGPT side panel"
    },
    "_execute_browser_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Period",
        "mac": "Command+Shift+Period"
      }
    }
  },
  "optional_permissions": [
    "downloads.open"
  ],
  "side_panel": {
    "default_path": "side-panel-loading.html"
  },
  "web_accessible_resources": [
    "images/cursor-chat.png",
    "codex-work-sidepanel.html",
    "diagnostics.html",
    "embedded-sidechat.html"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": true
  },
  "sandbox": {
    "pages": [
      "js-kernel.html"
    ],
    "content_security_policy": "sandbox allow-scripts; default-src 'none'; script-src 'self' 'unsafe-eval'; worker-src blob:; connect-src 'none';"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "all_frames": false,
      "run_at": "document_start",
      "js": [
        "safari/sidebar-content.js"
      ]
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "all_frames": false,
      "run_at": "document_start",
      "js": [
        "content-scripts/chatgpt-website.js"
      ]
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "js": [
        "safari/sidechat-preload.js"
      ]
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "all_frames": true,
      "include_globs": [
        "*surface=browser_side_chat*"
      ],
      "run_at": "document_start",
      "js": [
        "content-scripts/side-chat-tab-mentions.js"
      ],
      "world": "ISOLATED"
    }
  ],
  "browser_action": {
    "default_icon": {
      "16": "images/icon16.png",
      "32": "images/icon32.png",
      "48": "images/icon48.png"
    },
    "default_title": "ChatGPT"
  }
}
